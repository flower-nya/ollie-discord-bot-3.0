# BOT READY
# ============================================================

@bot.event
async def on_ready():

    print()
    print("================================")
    print("🤖 OLIVER IS ONLINE!")
    print(f"👤 Logged in as: {bot.user}")
    print(f"🆔 Bot ID: {bot.user.id}")
    print("💙 Oliver • Ollie • Olive")
    print("================================")
    print()

    try:

        guild = discord.Object(
            id=GUILD_ID
        )

        # Copy commands to this server
        bot.tree.copy_global_to(
            guild=guild
        )

        # Sync directly to this server
        synced = await bot.tree.sync(
            guild=guild
        )

        print(
            f"✅ Synced {len(synced)} commands "
            f"to your server."
        )

    except Exception as error:

        print(
            f"❌ Command sync error: {error}"
        )

    if not daily_holiday_checker.is_running():

        daily_holiday_checker.start()


