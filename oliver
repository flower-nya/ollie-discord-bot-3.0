# OLIVER CHAT RESPONSE
# ============================================================

def get_oliver_response(text):

    text = text.lower().strip()

    # Today's holiday
    if (
        "today's holiday" in text
        or "todays holiday" in text
        or "what is today's holiday" in text
        or "what's today's holiday" in text
        or "what holiday is today" in text
        or "what holiday is it" in text
        or "holiday today" in text
        or "national holiday today" in text
        or "what national holiday is today" in text
    ):

        return "HOLIDAY_LOOKUP"

    # How are you?
    if "how are you" in text:

        return random.choice([
            "I'm doing great! 🤖💙",
            "I'm doing awesome! Thanks for asking! 😄",
            "I'm good! Just hanging out! 🎉",
        ])

    # Who are you?
    if "who are you" in text:

        return (
            "I'm Oliver! 🤖\n\n"
            "You can call me Oliver, Ollie, or Olive! "
            "I'm your National Holiday Bot! 🇺🇸🎉"
        )

    # Thanks
    if "thank" in text:

        return random.choice([
            "You're welcome! 💙",
            "Anytime! 😄",
            "Of course! 🤖",
        ])

    # Greetings
    if any(
        word in text
        for word in (
            "hello",
            "hi",
            "hey"
        )
    ):

        return random.choice([
            "Hey! 👋",
            "Hello! 😄",
            "Hey there! 🤖",
            "Hi! What's up? 💙",
        ])

    return random.choice([
        "Yep? 👀",
        "Hey! I'm listening. 🤖",
        "What's up? 😄",
        "You called? 👀",
        "I'm here! 💙",
    ])


# ============================================================
# NORMAL MESSAGES
# ============================================================

@bot.event
async def on_message(message):

    # Don't respond to himself
    if message.author == bot.user:
        return

    text = (
        message.content
        .lower()
        .strip()
    )

    print(
        f"📨 Message received: {message.content}"
    )

    name_used = any(
        name in text
        for name in OLIVER_NAMES
    )

    mentioned = (
        bot.user in message.mentions
    )

    if name_used or mentioned:

        print(
            "💙 Someone called Ollie!"
        )

        response = get_oliver_response(
            text
        )

        try:

            # ------------------------------------------------
            # TODAY'S HOLIDAY
            # ------------------------------------------------

            if response == "HOLIDAY_LOOKUP":

                today = datetime.now()

                holiday = (
                    get_todays_holiday()
                )

                if holiday is None:

                    await message.channel.send(
                        "📅 I don't have a national holiday "
                        f"listed for **{today.strftime('%B %d')}**."
                    )

                else:

                    embed = make_holiday_embed(
                        holiday,
                        today.month,
                        today.day
                    )

                    await message.channel.send(
                        embed=embed
                    )

            # ------------------------------------------------
            # NORMAL RESPONSE
            # ------------------------------------------------

            else:

                await message.channel.send(
                    response
                )

            print(
                "✅ Ollie sent a reply!"
            )

        except discord.Forbidden:

            print(
                "❌ Ollie doesn't have permission "
                "to send messages here."
            )

        except discord.HTTPException as error:

            print(
                f"❌ Discord couldn't send the message: "
                f"{error}"
            )

    await bot.process_commands(message)


