# GET TODAY'S HOLIDAY
# ============================================================

def get_todays_holiday():

    today = datetime.now()

    return HOLIDAYS.get(
        (today.month, today.day)
    )


# ============================================================
# GET NEXT HOLIDAY
# ============================================================

def get_next_holiday():

    today = datetime.now()

    upcoming = []

    for (month, day), holiday in HOLIDAYS.items():

        if (
            month > today.month
            or (
                month == today.month
                and day > today.day
            )
        ):

            upcoming.append(
                (month, day, holiday)
            )

    if upcoming:

        upcoming.sort(
            key=lambda item: (
                item[0],
                item[1]
            )
        )

        return upcoming[0]

    # If there are no more holidays this year,
    # return the first holiday of next year.
    all_holidays = []

    for (month, day), holiday in HOLIDAYS.items():

        all_holidays.append(
            (month, day, holiday)
        )

    all_holidays.sort(
        key=lambda item: (
            item[0],
            item[1]
        )
    )

    if all_holidays:
        return all_holidays[0]

    return None


# ============================================================
# MAKE AESTHETIC EMBED
# ============================================================

def make_holiday_embed(
    holiday,
    month,
    day
):

    name = holiday["name"]
    emoji = holiday["emoji"]
    description = holiday["description"]
    fact = holiday["fact"]

    embed = discord.Embed(
        title=f"{emoji}  {name}",
        description=(
            f"**📅 {datetime.now().strftime('%B')} {day}**\n\n"
            f"{description}"
        ),
        color=discord.Color.from_rgb(
            116,
            149,
            255
        )
    )

    embed.add_field(
        name="✨ Did you know?",
        value=fact,
        inline=False
    )

    embed.add_field(
        name="💙 Ollie's note",
        value=(
            "I hope you have a wonderful day! "
            "Take a moment to celebrate, learn something new, "
            "or simply enjoy the occasion. 🤖"
        ),
        inline=False
    )

    embed.set_footer(
        text="Oliver • Ollie • Olive  •  National Holiday Bot 🤖"
    )

    return embed


