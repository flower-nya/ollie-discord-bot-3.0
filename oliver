# DAILY HOLIDAY POST
# ============================================================

last_posted_date = None


async def post_daily_holiday():

    global last_posted_date

    today = datetime.now().date()

    # Prevent duplicate messages
    if last_posted_date == today:

        print(
            "📅 Today's holiday has already been posted."
        )

        return

    channel = bot.get_channel(
        HOLIDAY_CHANNEL_ID
    )

    if channel is None:

        print(
            "❌ Oliver could not find the holiday channel."
        )

        return

    holiday = get_todays_holiday()

    if holiday is None:

        print(
            "📅 No configured national holiday today."
        )

        last_posted_date = today

        return

    now = datetime.now()

    embed = make_holiday_embed(
        holiday,
        now.month,
        now.day
    )

    role_mention = (
        f"<@&{NATIONAL_HOLIDAY_ROLE_ID}>"
    )

    try:

        await channel.send(
            content=(
                f"{role_mention}\n"
                f"╭─────────────── ✨\n"
                f"│ **TODAY'S NATIONAL HOLIDAY**\n"
                f"╰─────────────── ✨"
            ),
            embed=embed,
            allowed_mentions=discord.AllowedMentions(
                roles=True
            )
        )

        last_posted_date = today

        print(
            f"✅ Posted today's holiday: "
            f"{holiday['name']}"
        )

    except discord.Forbidden:

        print(
            "❌ Oliver doesn't have permission "
            "to send messages or mention the role."
        )

    except discord.HTTPException as error:

        print(
            f"❌ Discord error: {error}"
        )


